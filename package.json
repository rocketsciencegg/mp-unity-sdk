{
  "name": "gg.rocketscience.services.multiplay",
  "displayName": "Multiplay by Rocket Science",
  "version": "2.0.0",
  "unity": "2021.3",
  "description": "The Multiplay SDK provides functionality to facilitate Multiplay services.",
  "_upm": {
    "gameService": {
      "genericDashboardUrl": "http://dashboard.multiplay.dev/",
      "projectDashboardUrl": "http://dashboard.multiplay.dev/en/organizations/{0}/projects/{1}/environment/default/overview",
      "projectDashboardUrlType": "OrganizationKeyAndProjectGuid",
      "onboardingUrl": "https://support.multiplay.dev/articles/8817738617-onboarding-to-multiplay"
    }
  },
  "dependencies": {
    "com.unity.services.core": "1.12.5",
    "com.unity.services.wire": "1.4.0",
    "com.unity.modules.unitywebrequest": "1.0.0",
    "com.unity.modules.unitywebrequestassetbundle": "1.0.0",
    "com.unity.modules.unitywebrequestaudio": "1.0.0",
    "com.unity.modules.unitywebrequesttexture": "1.0.0",
    "com.unity.modules.unitywebrequestwww": "1.0.0",
    "com.unity.nuget.newtonsoft-json": "3.0.2",
    "com.unity.modules.jsonserialize": "1.0.0",
    "com.unity.transport": "2.6.0"
  }
}
